<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_conditioners_service_list" model="ir.ui.view">
        <field name="name">conditioners.service.list</field>
        <field name="model">conditioners.service</field>
        <field name="arch" type="xml">
            <list string="Услуги" default_order="sequence,id">
                <field name="sequence" widget="handle"/>
                <field name="image" widget="image" options="{'size': [64, 64]}"/>
                <field name="name"/>
                <field name="price_from" optional="show"/>
                <field name="show_on_homepage" widget="boolean_toggle"/>
                <field name="is_published" widget="boolean_toggle"/>
                <field name="website_id" groups="website.group_multi_website" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_conditioners_service_form" model="ir.ui.view">
        <field name="name">conditioners.service.form</field>
        <field name="model">conditioners.service</field>
        <field name="arch" type="xml">
            <form string="Услуга">
                <sheet>
                    <field name="image" widget="image" class="oe_avatar" options="{'preview_image': 'image'}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Электромонтаж"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="price_from" placeholder="от 5 000 ₽"/>
                            <field name="icon" placeholder="fa-bolt"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="is_published"/>
                            <field name="show_on_homepage"/>
                            <field name="website_id" groups="website.group_multi_website"/>
                        </group>
                    </group>
                    <group string="Описание">
                        <field name="description" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_conditioners_service_search" model="ir.ui.view">
        <field name="name">conditioners.service.search</field>
        <field name="model">conditioners.service</field>
        <field name="arch" type="xml">
            <search string="Услуги">
                <field name="name"/>
                <filter string="На сайте" name="published" domain="[('is_published', '=', True)]"/>
                <filter string="На главной" name="homepage" domain="[('show_on_homepage', '=', True)]"/>
                <filter string="Скрыты" name="hidden" domain="[('is_published', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_conditioners_service" model="ir.actions.act_window">
        <field name="name">Услуги</field>
        <field name="res_model">conditioners.service</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_published': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Добавьте услугу
            </p>
            <p>
                Укажите название, описание и цену. Опубликованные услуги появятся
                на странице «Услуги»; отмеченные «На главной» — в блоке на главной.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_conditioners_service"
        name="Услуги"
        parent="website.menu_content"
        action="action_conditioners_service"
        sequence="20"
        groups="website.group_website_designer"/>
</odoo>
