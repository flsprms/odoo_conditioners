<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Hero -->
    <template id="s_conditioners_hero" name="Profimontazh Hero">
        <section class="s_conditioners_hero pt96 pb96">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-lg-7">
                        <p class="o_conditioners_hero_kicker mb-2">Томск · монтаж и электромонтаж</p>
                        <h1 class="display-4 fw-bold mb-3">ПрофиМонтаж</h1>
                        <p class="lead mb-4">
                            Монтаж, электромонтаж и установка оборудования.
                            Выезд мастера в день обращения, договор и гарантия на работы.
                        </p>
                        <div class="d-flex flex-wrap gap-2">
                            <a href="/kontakty" class="btn btn-primary btn-lg">Оставить заявку</a>
                            <a href="tel:+79234363777" class="btn btn-outline-light btn-lg">
                                <i class="fa fa-phone me-1"/> Позвонить
                            </a>
                            <a href="https://max.ru/u/f9LHodD0cOJzh6eAHpIDT9mzvkSp9EmSBi1vHEoy87x8iyjWudjwEMob-ds" class="btn btn-outline-light btn-lg" target="_blank" rel="noopener noreferrer">
                                <i class="fa fa-comment me-1"/> MAX
                            </a>
                        </div>
                    </div>
                    <div class="col-lg-5 d-none d-lg-flex justify-content-center gap-4 o_conditioners_hero_icons">
                        <i class="fa fa-wrench fa-4x" title="Монтаж"/>
                        <i class="fa fa-bolt fa-4x" title="Электромонтаж"/>
                        <i class="fa fa-cogs fa-4x" title="Оборудование"/>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <!-- Advantages -->
    <template id="s_conditioners_advantages" name="Profimontazh Advantages">
        <section class="s_conditioners_advantages pt48 pb48">
            <div class="container">
                <h2 class="text-center mb-4">Почему выбирают нас</h2>
                <div class="row g-4">
                    <div class="col-md-6 col-lg-3">
                        <div class="text-center p-3 o_conditioners_advantage">
                            <i class="fa fa-clock-o fa-3x mb-3" title="Сроки"/>
                            <h5>Быстрый выезд</h5>
                            <p class="text-muted mb-0">Мастер приедет в удобное для вас время, часто в день заявки.</p>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-3">
                        <div class="text-center p-3 o_conditioners_advantage">
                            <i class="fa fa-shield fa-3x mb-3" title="Гарантия"/>
                            <h5>Гарантия</h5>
                            <p class="text-muted mb-0">Гарантия на монтаж, подключение и выполненные работы.</p>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-3">
                        <div class="text-center p-3 o_conditioners_advantage">
                            <i class="fa fa-wrench fa-3x mb-3" title="Опыт"/>
                            <h5>Опытные мастера</h5>
                            <p class="text-muted mb-0">Монтаж, электрика и установка оборудования в квартирах и на объектах.</p>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-3">
                        <div class="text-center p-3 o_conditioners_advantage">
                            <i class="fa fa-ruble fa-3x mb-3" title="Цены"/>
                            <h5>Честные цены</h5>
                            <p class="text-muted mb-0">Фиксируем стоимость до начала работ, без скрытых доплат.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <!-- Services cards from admin -->
    <template id="s_conditioners_services" name="Profimontazh Services">
        <section class="s_conditioners_services pt48 pb48">
            <div class="container">
                <h2 class="text-center mb-4">Наши услуги</h2>
                <t t-set="service_homepage_only" t-value="True"/>
                <t t-call="website_conditioners.conditioners_service_cards"/>
                <t t-set="published_services" t-value="request.env['conditioners.service'].search_published()"/>
                <t t-set="homepage_services" t-value="request.env['conditioners.service'].search_published(homepage_only=True)"/>
                <div t-if="len(published_services) &gt; len(homepage_services)" class="text-center mt-4">
                    <a href="/uslugi" class="btn btn-primary">Все услуги</a>
                </div>
            </div>
        </section>
    </template>

    <!-- Reviews -->
    <template id="s_conditioners_reviews" name="Profimontazh Reviews">
        <section class="s_conditioners_reviews pt48 pb48">
            <div class="container o_conditioners_reviews_container">
                <h2 class="text-center mb-4">Отзывы клиентов</h2>
                <t t-set="review_limit" t-value="3"/>
                <t t-call="website_conditioners.conditioners_review_cards"/>
                <div class="text-center mt-4">
                    <a href="/otzyvy" class="btn btn-outline-primary">Все отзывы</a>
                </div>
            </div>
        </section>
    </template>

    <!-- FAQ -->
    <template id="s_conditioners_faq" name="Profimontazh FAQ">
        <section class="s_conditioners_faq pt48 pb48">
            <div class="container">
                <h2 class="text-center mb-4">Частые вопросы</h2>
                <t t-set="faq_homepage_only" t-value="True"/>
                <t t-call="website_conditioners.conditioners_faq_accordion"/>
                <t t-set="published_faqs" t-value="request.env['conditioners.faq'].search_published()"/>
                <t t-set="homepage_faqs" t-value="request.env['conditioners.faq'].search_published(homepage_only=True)"/>
                <div t-if="len(published_faqs) &gt; len(homepage_faqs)" class="text-center mt-4">
                    <a href="/faq" class="btn btn-outline-primary">Все вопросы</a>
                </div>
            </div>
        </section>
    </template>

    <!-- Contact form -->
    <template id="s_conditioners_contact_form" name="Profimontazh Contact Form">
        <section t-attf-class="s_website_form #{'' if contact_form_embedded else 'pt48 pb48'}" data-snippet="s_website_form" data-name="Форма заявки">
            <div t-attf-class="#{'' if contact_form_embedded else 'container'}">
                <div t-attf-class="row #{'' if contact_form_embedded else 'justify-content-center'}">
                    <div t-attf-class="#{'' if contact_form_embedded else 'col-lg-8'}">
                        <h2 t-if="not contact_form_embedded" class="text-center mb-4">Оставить заявку</h2>
                        <h3 t-if="contact_form_embedded" class="h4 mb-3">Оставить заявку</h3>
                        <form action="/website/form/" method="post" class="o_mark_required" data-mark="*"
                              data-model_name="crm.lead" data-success-mode="redirect"
                              data-success-page="/contactus-thank-you">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <div class="row">
                                <div class="s_website_form_field mb-3 col-12" data-type="char" data-name="contact_name">
                                    <label class="col-form-label" for="contact_name">Ваше имя</label>
                                    <input id="contact_name" type="text" class="form-control s_website_form_input"
                                           name="contact_name" required="" placeholder="Иван"/>
                                </div>
                                <div class="s_website_form_field mb-3 col-md-6" data-type="char" data-name="phone">
                                    <label class="col-form-label" for="phone">Телефон</label>
                                    <input id="phone" type="tel" class="form-control s_website_form_input"
                                           name="phone" required="" placeholder="+7 (999) 000-00-00"/>
                                </div>
                                <div class="s_website_form_field mb-3 col-md-6" data-type="email" data-name="email_from">
                                    <label class="col-form-label" for="email_from">Email</label>
                                    <input id="email_from" type="email" class="form-control s_website_form_input"
                                           name="email_from" placeholder="email@example.com"/>
                                </div>
                                <div class="s_website_form_field mb-3 col-12" data-type="selection" data-name="x_website_service_type">
                                    <label class="col-form-label" for="x_website_service_type">Тип услуги</label>
                                    <select id="x_website_service_type" class="form-select s_website_form_input"
                                            name="x_website_service_type" required="">
                                        <option value="">Выберите услугу...</option>
                                        <option value="montage">Монтаж</option>
                                        <option value="electro">Электромонтаж</option>
                                        <option value="service">Обслуживание</option>
                                        <option value="other">Другое</option>
                                    </select>
                                </div>
                                <div class="s_website_form_field mb-3 col-12" data-type="text" data-name="description">
                                    <label class="col-form-label" for="description">Сообщение</label>
                                    <textarea id="description" class="form-control s_website_form_input"
                                              name="description" rows="4"
                                              placeholder="Адрес, вид работ, удобное время звонка..."/>
                                </div>
                                <div class="col-12 text-center">
                                    <button type="submit" class="btn btn-primary btn-lg s_website_form_send">
                                        Отправить заявку
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </section>
    </template>

</odoo>
