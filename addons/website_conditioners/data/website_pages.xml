<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Главная: переопределение стандартной homepage -->
    <template id="conditioners_homepage" inherit_id="website.homepage" name="Profimontazh Homepage">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure oe_empty">
                <t t-call="website_conditioners.s_conditioners_hero"/>
                <t t-call="website_conditioners.s_conditioners_advantages"/>
                <t t-call="website_conditioners.s_conditioners_services"/>
                <t t-call="website_conditioners.s_conditioners_reviews"/>
                <t t-call="website_conditioners.s_conditioners_contact_form"/>
            </div>
        </xpath>
    </template>

    <template id="contactus_thanks_profimontazh" inherit_id="website.contactus_thanks" name="Profimontazh thank you page">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure">
                <section class="pt48 pb48">
                    <div class="container text-center">
                        <i class="fa fa-paper-plane fa-2x mb-3 rounded-circle text-bg-success" role="presentation"/>
                        <h1 class="fw-bolder">Спасибо!</h1>
                        <p class="lead mb-0">Заявка отправлена.</p>
                        <p class="lead">Перезвоним в течение 30 минут в рабочее время.</p>
                        <a href="/" class="btn btn-primary">На главную</a>
                    </div>
                </section>
            </div>
        </xpath>
    </template>

    <record id="website.contactus_thanks" model="website.page">
        <field name="name">Спасибо</field>
    </record>

    <!-- Услуги -->
    <record id="page_uslugi" model="website.page">
        <field name="name">Услуги</field>
        <field name="type">qweb</field>
        <field name="url">/uslugi</field>
        <field name="website_indexed" eval="True"/>
        <field name="is_published" eval="True"/>
        <field name="key">website_conditioners.page_uslugi</field>
        <field name="arch" type="xml">
            <t name="Услуги" t-name="website_conditioners.page_uslugi">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure">
                        <section class="pt48 pb24">
                            <div class="container">
                                <h1>Услуги и цены</h1>
                                <p class="lead text-muted">Монтаж, электромонтаж и установка оборудования в Томске. Состав и цены можно уточнить при заявке.</p>
                            </div>
                        </section>
                        <section class="s_conditioners_services pb48">
                            <div class="container">
                                <t t-set="service_homepage_only" t-value="False"/>
                                <t t-call="website_conditioners.conditioners_service_cards"/>
                            </div>
                        </section>
                        <t t-call="website_conditioners.s_conditioners_contact_form"/>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <!-- О нас -->
    <record id="page_o_nas" model="website.page">
        <field name="name">О нас</field>
        <field name="type">qweb</field>
        <field name="url">/o-nas</field>
        <field name="website_indexed" eval="True"/>
        <field name="is_published" eval="True"/>
        <field name="key">website_conditioners.page_o_nas</field>
        <field name="arch" type="xml">
            <t name="О нас" t-name="website_conditioners.page_o_nas">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure">
                        <section class="pt48 pb48">
                            <div class="container">
                                <h1>О компании</h1>
                                <div class="row mt-4">
                                    <div class="col-lg-8">
                                        <p class="lead">
                                            «ПрофиМонтаж» — команда мастеров по монтажу и электромонтажу в Томске.
                                        </p>
                                        <p>
                                            Работаем с квартирами, частными домами и небольшими коммерческими объектами:
                                            установка оборудования, прокладка трасс и кабеля, подключение и пусконаладка.
                                        </p>
                                        <p>
                                            Все работы выполняем с договором и гарантией. Используем профессиональный
                                            инструмент и расходные материалы, заранее согласовываем смету.
                                        </p>
                                    </div>
                                    <div class="col-lg-4">
                                        <div class="card shadow-sm o_conditioners_about_card">
                                            <div class="card-body">
                                                <h5 class="card-title">Наши преимущества</h5>
                                                <ul class="mb-0">
                                                    <li>Выезд в день обращения</li>
                                                    <li>Работаем без выходных</li>
                                                    <li>Официальный договор</li>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <!-- Портфолио -->
    <record id="page_portfolio" model="website.page">
        <field name="name">Портфолио</field>
        <field name="type">qweb</field>
        <field name="url">/portfolio</field>
        <field name="website_indexed" eval="True"/>
        <field name="is_published" eval="True"/>
        <field name="key">website_conditioners.page_portfolio</field>
        <field name="arch" type="xml">
            <t name="Портфолио" t-name="website_conditioners.page_portfolio">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure">
                        <section class="pt48 pb48">
                            <div class="container">
                                <h1 class="mb-4">Наши работы</h1>
                                <t t-call="website_conditioners.conditioners_portfolio_gallery"/>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <!-- Отзывы -->
    <record id="page_otzyvy" model="website.page">
        <field name="name">Отзывы</field>
        <field name="type">qweb</field>
        <field name="url">/otzyvy</field>
        <field name="website_indexed" eval="True"/>
        <field name="is_published" eval="True"/>
        <field name="key">website_conditioners.page_otzyvy</field>
        <field name="arch" type="xml">
            <t name="Отзывы" t-name="website_conditioners.page_otzyvy">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure">
                        <section class="pt48 pb24">
                            <div class="container">
                                <h1>Отзывы клиентов</h1>
                            </div>
                        </section>
                        <t t-set="review_limit" t-value="None"/>
                        <t t-call="website_conditioners.s_conditioners_reviews_page"/>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <!-- FAQ -->
    <record id="page_faq" model="website.page">
        <field name="name">FAQ</field>
        <field name="type">qweb</field>
        <field name="url">/faq</field>
        <field name="website_indexed" eval="True"/>
        <field name="is_published" eval="True"/>
        <field name="key">website_conditioners.page_faq</field>
        <field name="arch" type="xml">
            <t name="FAQ" t-name="website_conditioners.page_faq">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure">
                        <section class="s_conditioners_faq pt48 pb48">
                            <div class="container">
                                <h1 class="mb-4">Частые вопросы</h1>
                                <t t-set="faq_homepage_only" t-value="False"/>
                                <t t-set="faq_accordion_id" t-value="'conditionersFaqPage'"/>
                                <t t-call="website_conditioners.conditioners_faq_accordion"/>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <!-- Контакты -->
    <record id="page_kontakty" model="website.page">
        <field name="name">Контакты</field>
        <field name="type">qweb</field>
        <field name="url">/kontakty</field>
        <field name="website_indexed" eval="True"/>
        <field name="is_published" eval="True"/>
        <field name="key">website_conditioners.page_kontakty</field>
        <field name="arch" type="xml">
            <t name="Контакты" t-name="website_conditioners.page_kontakty">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure">
                        <section class="o_conditioners_contacts pt48 pb48">
                            <div class="container">
                                <h1 class="text-center mb-4">Контакты</h1>
                                <div class="row g-4 align-items-stretch">
                                    <div class="col-lg-5">
                                        <div class="card shadow-sm h-100 o_conditioners_contact_card">
                                            <div class="card-body p-4">
                                                <p class="h4 mb-3">ПрофиМонтаж</p>
                                                <p class="mb-3">
                                                    <i class="fa fa-map-marker me-2 text-primary"/> Томск
                                                </p>
                                                <p class="mb-3">
                                                    <i class="fa fa-phone me-2 text-primary"/>
                                                    <a href="tel:+79234363777" class="text-decoration-none">+7 (923) 436-37-77</a>
                                                </p>
                                                <p class="mb-3 text-muted">
                                                    <i class="fa fa-clock-o me-2 text-primary"/> Пн–Вс: 9:00–21:00
                                                </p>
                                                <a href="https://max.ru/u/f9LHodD0cOJzh6eAHpIDT9mzvkSp9EmSBi1vHEoy87x8iyjWudjwEMob-ds" class="btn btn-primary" target="_blank" rel="noopener noreferrer">
                                                    <i class="fa fa-comment me-1"/> Написать в MAX
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-7">
                                        <div class="card shadow-sm h-100 o_conditioners_contact_form_card">
                                            <div class="card-body p-4">
                                                <t t-set="contact_form_embedded" t-value="True"/>
                                                <t t-call="website_conditioners.s_conditioners_contact_form"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
</odoo>
